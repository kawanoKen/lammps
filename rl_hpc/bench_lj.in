# Research baseline derived from the bundled fixed-size benchmark bench/in.lj.
# The physical system is unchanged: 32,000-atom LJ fluid when x=y=z=1.
# Command-line -var values are used by rl_hpc/run_experiment.py.

variable        x index 1
variable        y index 1
variable        z index 1
variable        steps index 1000
variable        seed index 87287
variable        skin index 0.3
variable        neigh_every index 20
variable        neigh_delay index 0
variable        neigh_check index no

variable        xx equal 20*$x
variable        yy equal 20*$y
variable        zz equal 20*$z

units           lj
atom_style      atomic

lattice         fcc 0.8442
region          box block 0 ${xx} 0 ${yy} 0 ${zz}
create_box      1 box
create_atoms    1 box
mass            1 1.0

velocity        all create 1.44 ${seed} loop geom

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        ${skin} bin
neigh_modify    delay ${neigh_delay} every ${neigh_every} check ${neigh_check}

fix             1 all nve

thermo          100
thermo_style    custom step temp pe ke etotal press
timer           full

run             ${steps}
