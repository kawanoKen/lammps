[Unit]
Description=Shock/NEMD resilient continuous-skin idle and CPU-jitter training
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/work/kawano/lammps
ExecStart=/home/kawano/miniconda3/bin/python -u /work/kawano/lammps/rl_hpc/characterization/shock/run_skin_study.py
Restart=on-failure
RestartSec=30s
KillMode=control-group
TimeoutStopSec=30s

[Install]
WantedBy=default.target
