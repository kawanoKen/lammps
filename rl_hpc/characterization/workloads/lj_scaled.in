# Homogeneous Lennard-Jones workload for characterization.
# 2 x 2 x 1 replication of the 32,000-atom benchmark: 128,000 atoms.

variable        x index 2
variable        y index 2
variable        z index 1
variable        steps index 100
variable        seed index 87287
variable        skin index 0.3
variable        neigh_every index 20
variable        neigh_delay index 0
variable        neigh_check index yes

variable        xx equal 20*$x
variable        yy equal 20*$y
variable        zz equal 20*$z

units           lj
atom_style      atomic

lattice         fcc 0.8442
region          box block 0 ${xx} 0 ${yy} 0 ${zz}
create_box      1 box
create_atoms    1 box
mass            1 1.0

velocity        all create 1.44 ${seed} loop geom

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

neighbor        ${skin} bin
neigh_modify    delay ${neigh_delay} every ${neigh_every} check ${neigh_check}

fix             integrator all nve

thermo          100
thermo_style    custom step temp pe ke etotal press cpu spcpu
timer           normal

run             ${steps}
